# ==== SERVER ====
PORT=3000
DOMAIN=https://marketpanel.kenxzo.my.id
JWT_SECRET=ganti_dengan_random_string_panjang_banget
ADMIN_EMAIL=admin@kenxzo.my.id
ADMIN_PASSWORD=GantiPasswordIni123!

# ==== DATABASE (Turso / libSQL) - WAJIB untuk deploy ke Vercel ====
# Vercel serverless tidak punya filesystem persisten, jadi database SQLite
# lokal (better-sqlite3) diganti Turso (SQLite yang di-hosting).
# Cara dapetin gratis: lihat komentar lengkap di config/db.js
TURSO_DATABASE_URL=libsql://nama-db-kamu.turso.io
TURSO_AUTH_TOKEN=isi_token_dari_turso

# ==== CRON (Vercel Cron Jobs untuk auto-expire paket) ====
# String random bebas, dipakai Vercel buat otentikasi panggilan cron ke
# /api/cron/expiry-check (Vercel otomatis kirim header ini kalau CRON_SECRET diisi).
CRON_SECRET=ganti_dengan_random_string_lain

# ==== WEBHOOK (opsional, kalau nanti pakai auto-verifikasi pembayaran) ====
WEBHOOK_SECRET=ganti_dengan_random_string_lagi

# ==== QRIS STATIS (DANA Bisnis) ====
QRIS_STATIC_STRING=00020101021126570011ID.DANA.WWW...ISI_STRING_QRIS_ASLI_KAMU

# ==== PANEL 1: PTERODACTYL (classic) ====
PTERO_PANEL_URL=https://panelkenzo.kenxzo.my.id
PTERO_APP_API_KEY=ptla_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PTERO_LOCATION_ID=1

PTERO_NEST_MINECRAFT=1
PTERO_EGG_MINECRAFT=1
PTERO_DOCKER_MINECRAFT=ghcr.io/pterodactyl/yolks:java_17

PTERO_NEST_WHATSAPP=5
PTERO_EGG_WHATSAPP=17
PTERO_DOCKER_WHATSAPP=ghcr.io/parkervcp/yolks:nodejs_22

# Variabel egg WhatsApp (KenzoHostWings) - opsional, bisa dikosongkan
PTERO_ENV_CMD_RUN=npm start
PTERO_ENV_GIT_ADDRESS=
PTERO_ENV_BRANCH=
PTERO_ENV_USERNAME=
PTERO_ENV_ACCESS_TOKEN=

# ==== PANEL 2: PYRODACTYL ====
# Isi ini kalau Pyrodactyl kamu adalah instance/panel TERPISAH dari Pterodactyl
# di atas. Kalau ternyata satu panel yang sama (cuma beda UI/tema), copy nilai
# yang sama persis kayak PTERO_* di atas.
PYRO_PANEL_URL=https://ISI_URL_PANEL_PYRODACTYL_KAMU
PYRO_APP_API_KEY=ptla_ISI_API_KEY_PYRODACTYL
PYRO_LOCATION_ID=1

PYRO_NEST_MINECRAFT=1
PYRO_EGG_MINECRAFT=1
PYRO_DOCKER_MINECRAFT=ghcr.io/pterodactyl/yolks:java_17

PYRO_NEST_WHATSAPP=1
PYRO_EGG_WHATSAPP=1
PYRO_DOCKER_WHATSAPP=ghcr.io/parkervcp/yolks:nodejs_22

# ==== PANEL 3: PRIVATE SERVER (Gold Series) ====
# Paket "Private Server" dijalankan di atas VPS TERPISAH (rekomendasi 16GB /
# 4CPU) supaya benar-benar privat & tidak numpang node shared biasa. Buyer
# tetap bisa pilih egg Minecraft atau WhatsApp Bot saat checkout, sama seperti
# Pterodactyl/Pyrodactyl — isi nest/egg ID sesuai yang kamu siapkan di panel.
PRIVATE_PANEL_URL=https://ISI_URL_PANEL_PRIVATE_KAMU
PRIVATE_APP_API_KEY=ptla_ISI_API_KEY_PRIVATE
PRIVATE_LOCATION_ID=1

PRIVATE_NEST_MINECRAFT=
PRIVATE_EGG_MINECRAFT=
PRIVATE_DOCKER_MINECRAFT=ghcr.io/pterodactyl/yolks:java_17

PRIVATE_NEST_WHATSAPP=
PRIVATE_EGG_WHATSAPP=
PRIVATE_DOCKER_WHATSAPP=ghcr.io/parkervcp/yolks:nodejs_22
